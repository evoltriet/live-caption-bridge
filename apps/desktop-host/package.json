{
  "name": "@live-caption-bridge/desktop-host",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Windows host and operator application for Live Caption Bridge.",
  "main": "./out/main/index.js",
  "author": "Triet Pham",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "dist:win": "pnpm build && electron-builder --win nsis portable && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1"
  },
  "dependencies": {
    "@live-caption-bridge/caption-client": "workspace:*",
    "@live-caption-bridge/caption-protocol": "workspace:*",
    "@live-caption-bridge/web-receiver": "workspace:*",
    "microsoft-cognitiveservices-speech-sdk": "^1.46.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.evoltriet.livecaptionbridge",
    "productName": "Live Caption Bridge",
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  }
}
