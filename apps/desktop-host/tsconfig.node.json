{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "../../packages/**/*.ts",
    "../web-receiver/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "moduleResolution": "Bundler",
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@live-caption-bridge/caption-client": ["../../packages/caption-client/src/index.ts"],
      "@live-caption-bridge/caption-protocol": ["../../packages/caption-protocol/src/index.ts"],
      "@live-caption-bridge/web-receiver": ["../web-receiver/src/index.ts"]
    }
  }
}
